# -----------------------------------------------------------------------------
# Fermosa AI Platform - Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- Application ---
# Public base URL of the app (used for redirects, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Environment: development | test | production
NODE_ENV="development"

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fermosa_platform?schema=public"

# --- Authentication (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32  (or: npx auth secret)
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
# Only needed when deployed behind a proxy or non-standard host
# AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Logging ---
# Minimum log level: debug | info | warn | error
LOG_LEVEL="debug"

# --- Storage (Sprint 2A.2) ---
# Which storage backend the factory selects: local | s3 | azure-blob | gcs | r2 | supabase
# Only "local" is implemented today.
STORAGE_PROVIDER="local"
# Root directory for the local provider (relative to the project; gitignored)
STORAGE_LOCAL_ROOT=".storage"

# --- Capability seams ---
# Which CRM connector strategy the factory selects: browser-automation | api | mock
CRM_CONNECTOR="mock"
# Which AI provider the factory selects: mock | claude | openai-vision | gemini | azure-openai
# Implemented: mock (Sprint 3.0), claude (Sprint 3.1)
AI_PROVIDER="mock"

# --- AI providers (Sprint 3.1) ---
# Anthropic API key — required only to execute the Claude provider (AI Playground).
# Leave unset to use the mock provider; the Claude option then fails gracefully.
# ANTHROPIC_API_KEY=""
