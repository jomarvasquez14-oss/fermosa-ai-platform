// -----------------------------------------------------------------------------
// Fermosa AI Platform - Database Schema
// PostgreSQL via Prisma ORM
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  AUDITOR
  BRANCH_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// Lifecycle of an audit submission — see docs/DOMAIN_MODEL.md §5.1 for the
// full state machine and allowed transitions (forward-only after SUBMITTED).
enum AuditSubmissionStatus {
  DRAFT
  UPLOADING
  SUBMITTED
  OCR_PROCESSING
  OCR_REVIEW
  CRM_COMPARISON
  REPORT_GENERATION
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Storage lifecycle of one logbook image (docs/DOMAIN_MODEL.md §5.2).
// OCR state deliberately lives on the future OcrResult, not here.
enum LogbookImageStatus {
  PENDING_UPLOAD
  UPLOADING
  STORED
  UPLOAD_FAILED
}

// Business events recorded on a submission's audit trail (Sprint 2A.2).
enum AuditTrailAction {
  SUBMISSION_CREATED
  DRAFT_SAVED
  SUBMISSION_SUBMITTED
  IMAGE_ADDED
  IMAGE_REMOVED
  IMAGE_REORDERED
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Branch Managers are assigned to exactly one branch; other roles may be null.
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  auditSubmissions  AuditSubmission[] @relation("SubmittedBy")
  auditTrailEntries AuditTrailEntry[] @relation("TrailActor")
  settingsUpdates   SystemSetting[]   @relation("SettingUpdatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

model Branch {
  id      String       @id @default(cuid())
  name    String
  code    String       @unique
  address String
  status  BranchStatus @default(ACTIVE)

  users            User[]
  auditSubmissions AuditSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Audit Module — authoritative model in docs/DOMAIN_MODEL.md (ADR-023).
// AuditSubmission is the aggregate root: images are reached only through it,
// and its invariants (image count, ordering, post-submit immutability) are
// enforced in the service layer. Future entities (OcrResult, CrmComparison,
// AuditReport) are specified in DOMAIN_MODEL.md §3 and persisted when their
// milestone arrives (ADR-019).
// ---------------------------------------------------------------------------

model AuditSubmission {
  id     String                @id @default(cuid())
  status AuditSubmissionStatus @default(DRAFT)
  notes  String?

  // The calendar date the logbook pages cover — not the upload date.
  auditDate DateTime @map("audit_date") @db.Date

  // Restrict: submissions are audit-trail records; the branch and the person
  // who submitted must never be deletable out from under them (ADR-010).
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  images       LogbookImage[]
  trailEntries AuditTrailEntry[]

  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Deliberately NOT unique on (branchId, auditDate): late follow-up
  // submissions for the same date are allowed (DOMAIN_MODEL.md §3, risk #2).
  @@index([branchId, auditDate])
  @@index([submittedById])
  @@index([status])
  @@map("audit_submissions")
}

model LogbookImage {
  id     String             @id @default(cuid())
  status LogbookImageStatus @default(PENDING_UPLOAD)

  // Cascade: images are owned by their submission (aggregate boundary).
  // Hard deletion of images is legal only while the submission is a DRAFT —
  // enforced in the service layer, not the database.
  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // 1-based page order; the page number shown to users is derived from this.
  // Contiguity is a service-layer invariant (reordering swaps break DB-level
  // uniqueness transiently, so no unique constraint here).
  displayOrder Int @map("display_order")

  // Viewing metadata (0/90/180/270). The stored file is never modified.
  rotation Int @default(0)

  originalFileName String  @map("original_file_name")
  mimeType         String? @map("mime_type")
  fileSizeBytes    Int?    @map("file_size_bytes")

  // Object-storage key — null until Sprint 2A.2 actually stores the binary.
  storageKey String?   @map("storage_key")
  uploadedAt DateTime? @map("uploaded_at")

  // Denormalized confidence of the accepted OCR result (Milestone 3 writes it;
  // full OCR data lives on the future OcrResult entity).
  ocrConfidence Float? @map("ocr_confidence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([submissionId, displayOrder])
  @@index([status])
  @@map("logbook_images")
}

// Immutable business-event log for one submission (Sprint 2A.2). Rows are
// append-only: never updated, never deleted independently of the submission.
model AuditTrailEntry {
  id     String           @id @default(cuid())
  action AuditTrailAction

  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id")
  actor   User   @relation("TrailActor", fields: [actorId], references: [id], onDelete: Restrict)

  /** Action-specific detail (image id, filename, old/new order, ...). IDs only — no blobs. */
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([actorId])
  @@map("audit_trail_entries")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
