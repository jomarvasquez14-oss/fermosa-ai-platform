// -----------------------------------------------------------------------------
// Fermosa AI Platform - Database Schema
// PostgreSQL via Prisma ORM
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  AUDITOR
  BRANCH_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// Lifecycle of an audit submission — see docs/DOMAIN_MODEL.md §5.1 for the
// full state machine and allowed transitions (forward-only after SUBMITTED).
enum AuditSubmissionStatus {
  DRAFT
  UPLOADING
  SUBMITTED
  OCR_PROCESSING
  OCR_REVIEW
  CRM_COMPARISON
  REPORT_GENERATION
  COMPLETED
  ARCHIVED
  CANCELLED
}

// Storage lifecycle of one logbook image (docs/DOMAIN_MODEL.md §5.2).
// OCR state deliberately lives on the future OcrResult, not here.
enum LogbookImageStatus {
  PENDING_UPLOAD
  UPLOADING
  STORED
  UPLOAD_FAILED
}

// Business events recorded on a submission's audit trail (Sprint 2A.2).
enum AuditTrailAction {
  SUBMISSION_CREATED
  DRAFT_SAVED
  SUBMISSION_SUBMITTED
  IMAGE_ADDED
  IMAGE_REMOVED
  IMAGE_REORDERED
}

// ---------------------------------------------------------------------------
// Audit findings (Sprint 3.5, ADR-028) — the platform's canonical output.
// Every producer (rule engine, CRM discovery, OCR, AI, manual review) creates
// or updates AuditFinding rows; no module invents its own result format.
// ---------------------------------------------------------------------------

// What kind of discrepancy this is. Extend via migration + DOMAIN_MODEL update.
enum FindingCategory {
  MISSING_IN_CRM // logbook entry has no matching CRM record
  MISSING_IN_LOGBOOK // CRM treatment absent from the logbook
  MISMATCHED_FIELD // values disagree (treatment, therapist, time, ...)
  UNMATCHED_PATIENT // patient could not be found in the CRM
  AMBIGUOUS_PATIENT // multiple CRM candidates, needs human disambiguation
  MISSING_INVOICE // treatment encoded but never invoiced
  RECORD_EDITED // CRM record changed after the audit date
  RECORD_DELETED // CRM record deleted after creation
  UNREADABLE_ENTRY // logbook line confirmed illegible during review
  DUPLICATE_ENTRY // same treatment recorded more than once
  OTHER
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Linear review workflow (DOMAIN_MODEL §5.5): OPEN → REVIEWED → RESOLVED,
// with reopening allowed. Findings are never deleted (audit record).
enum FindingStatus {
  OPEN
  REVIEWED
  RESOLVED
}

// Which module produced the finding — the provenance of the claim.
enum FindingSource {
  RULE_ENGINE
  CRM_DISCOVERY
  OCR
  AI_ANALYSIS
  MANUAL_REVIEW
}

// ---------------------------------------------------------------------------
// Audit orchestration (Sprint 3.6, ADR-029) — the workflow layer. A job runs
// one submission through the stage pipeline; recovery always derives from
// these rows, never from in-memory state or bus events.
// ---------------------------------------------------------------------------

// Pipeline stages in execution order (docs/DOMAIN_MODEL.md §5.6).
enum AuditStage {
  OCR
  HUMAN_REVIEW
  CRM_RETRIEVAL
  MATCHING
  REPORT
}

// Job/stage execution status (state machine in services/orchestrator).
enum AuditRunStatus {
  QUEUED
  RUNNING
  WAITING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

// Scheduled audit pipeline cadence (M0054, ADR-038).
enum ScheduleCadence {
  MANUAL
  NIGHTLY
  WEEKLY
  MONTHLY
}

// One scheduled pipeline run's terminal/active state (M0054).
enum PipelineRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Branch Managers are assigned to exactly one branch; other roles may be null.
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  auditSubmissions  AuditSubmission[] @relation("SubmittedBy")
  auditTrailEntries AuditTrailEntry[] @relation("TrailActor")
  auditJobs         AuditJob[]        @relation("JobStartedBy")
  settingsUpdates   SystemSetting[]   @relation("SettingUpdatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

model Branch {
  id      String       @id @default(cuid())
  name    String
  code    String       @unique
  address String
  status  BranchStatus @default(ACTIVE)

  users            User[]
  auditSubmissions AuditSubmission[]
  auditSchedules   AuditSchedule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Audit Module — authoritative model in docs/DOMAIN_MODEL.md (ADR-023).
// AuditSubmission is the aggregate root: images are reached only through it,
// and its invariants (image count, ordering, post-submit immutability) are
// enforced in the service layer. Future entities (OcrResult, CrmComparison,
// AuditReport) are specified in DOMAIN_MODEL.md §3 and persisted when their
// milestone arrives (ADR-019).
// ---------------------------------------------------------------------------

model AuditSubmission {
  id     String                @id @default(cuid())
  status AuditSubmissionStatus @default(DRAFT)
  notes  String?

  // The calendar date the logbook pages cover — not the upload date.
  auditDate DateTime @map("audit_date") @db.Date

  // Restrict: submissions are audit-trail records; the branch and the person
  // who submitted must never be deletable out from under them (ADR-010).
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  images            LogbookImage[]
  trailEntries      AuditTrailEntry[]
  findings          AuditFinding[]
  jobs              AuditJob[]
  evidenceSnapshots AuditEvidenceSnapshot[]
  pipelineRuns      PipelineRun[]

  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Deliberately NOT unique on (branchId, auditDate): late follow-up
  // submissions for the same date are allowed (DOMAIN_MODEL.md §3, risk #2).
  @@index([branchId, auditDate])
  @@index([submittedById])
  @@index([status])
  @@map("audit_submissions")
}

model LogbookImage {
  id     String             @id @default(cuid())
  status LogbookImageStatus @default(PENDING_UPLOAD)

  // Cascade: images are owned by their submission (aggregate boundary).
  // Hard deletion of images is legal only while the submission is a DRAFT —
  // enforced in the service layer, not the database.
  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // 1-based page order; the page number shown to users is derived from this.
  // Contiguity is a service-layer invariant (reordering swaps break DB-level
  // uniqueness transiently, so no unique constraint here).
  displayOrder Int @map("display_order")

  // Viewing metadata (0/90/180/270). The stored file is never modified.
  rotation Int @default(0)

  originalFileName String  @map("original_file_name")
  mimeType         String? @map("mime_type")
  fileSizeBytes    Int?    @map("file_size_bytes")

  // Object-storage key — null until Sprint 2A.2 actually stores the binary.
  storageKey String?   @map("storage_key")
  uploadedAt DateTime? @map("uploaded_at")

  // Denormalized confidence of the accepted OCR result (Milestone 3 writes it;
  // full OCR data lives on the future OcrResult entity).
  ocrConfidence Float? @map("ocr_confidence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([submissionId, displayOrder])
  @@index([status])
  @@map("logbook_images")
}

// One orchestration run for a submission. A submission has at most one
// active job; completed/cancelled jobs remain as history.
model AuditJob {
  id     String         @id @default(cuid())
  status AuditRunStatus @default(QUEUED)

  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Who started the run (Restrict — audit trail).
  startedById String @map("started_by_id")
  startedBy   User   @relation("JobStartedBy", fields: [startedById], references: [id], onDelete: Restrict)

  currentStage AuditStage? @map("current_stage")
  error        String?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  stages AuditJobStage[]

  @@index([submissionId, status])
  @@map("audit_jobs")
}

// One stage of one job. Attempts increment on retry; history is preserved
// in-place (attempt counter + timestamps), not by row duplication.
model AuditJobStage {
  id     String         @id @default(cuid())
  stage  AuditStage
  status AuditRunStatus @default(QUEUED)

  jobId String   @map("job_id")
  job   AuditJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  attempt Int     @default(0)
  error   String?
  /// Why the stage is WAITING (e.g. "human review pending").
  waitingReason String? @map("waiting_reason")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([jobId, stage])
  @@map("audit_job_stages")
}

// One audit discrepancy — the canonical output every module writes to
// (ADR-028). Owned by the submission aggregate; never hard-deleted (a false
// positive is RESOLVED with a resolution note, not removed).
model AuditFinding {
  id       String          @id @default(cuid())
  category FindingCategory
  severity FindingSeverity
  status   FindingStatus   @default(OPEN)
  source   FindingSource

  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// One-line human statement of the discrepancy.
  title String
  /// Full explanation: what was compared, what disagreed, why it matters.
  detail String
  /// Suggested next step for the reviewer (nullable — not all findings have one).
  recommendation String?

  /// What the authoritative source says vs. what the evidence shows.
  expectedValue String? @map("expected_value")
  actualValue   String? @map("actual_value")

  /// Typed evidence references (logbook field, CRM record, activity event, ...)
  /// — JSON validated against `findingEvidenceSchema`; IDs only, never blobs.
  evidence Json

  /// Producer confidence 0..1 (AI/rule engine); null for manual findings.
  confidence Float?

  reviewedAt DateTime? @map("reviewed_at")
  resolvedAt DateTime? @map("resolved_at")
  /// How it was closed: what was verified, corrected, or why it was a false positive.
  resolution String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([submissionId, status])
  @@index([category])
  @@index([severity])
  @@map("audit_findings")
}

// ---------------------------------------------------------------------------
// Audit evidence snapshots (M0043, ADR-035). The CRM stays the ONLY source of
// truth for operational data — the platform deliberately has NO Patient or
// Treatment tables and never synchronizes the CRM. This table stores immutable
// EVIDENCE: what the CRM looked like at the exact moment an audit read it, so
// every audit stays reproducible even after the CRM changes. Rows are
// append-only: never updated, never deleted independently of the submission.
// ---------------------------------------------------------------------------

model AuditEvidenceSnapshot {
  id String @id @default(cuid())

  // Owned by the submission aggregate — the ONLY relation this table has.
  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// The CRM's own patient id (provenance string, deliberately NOT a foreign
  /// key — no patient master table exists on the platform).
  crmPatientId String @map("crm_patient_id")

  /// Full NormalizedCrmPatientRecord (ADR-027) — validated against the Zod
  /// schema before persisting and again on every load.
  record Json

  /// SHA-256 over the canonical (sorted-key) record JSON. Verified on load;
  /// a mismatch means the evidence was tampered with or corrupted.
  contentHash String @map("content_hash")

  // Provenance — "when and how was this true?"
  connectorKind   String   @map("connector_kind")
  /// Version of the retrieval source: selector-map version for the browser
  /// connector, fixture version for the mock (first token of sourceRef).
  selectorVersion String   @map("selector_version")
  retrievedAt     DateTime @map("retrieved_at")

  /// Inclusive retrieval window (yyyy-mm-dd) when one was applied.
  windowFrom String? @map("window_from")
  windowTo   String? @map("window_to")

  /// Snapshot FORMAT version — bump via ADR when the stored shape changes.
  snapshotVersion Int @default(1) @map("snapshot_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([crmPatientId])
  @@map("audit_evidence_snapshots")
}

// ---------------------------------------------------------------------------
// Scheduled audit pipeline (M0054, ADR-038). A cadence layer over the existing
// per-submission orchestration: a schedule declares WHEN to run, a PipelineRun
// records the OUTCOME of one run (per-stage results as JSON). OCR is a declared
// stage that stays disabled until the OCR-integration phase — the stage list is
// data (services/pipeline/pipeline-stages.ts), never hard-coded branches.
// ---------------------------------------------------------------------------

model AuditSchedule {
  id      String          @id @default(cuid())
  cadence ScheduleCadence @default(MANUAL)
  enabled Boolean         @default(true)

  /// Optional branch scope — null means all branches. SetNull so removing a
  /// branch disables its scoping without destroying run history.
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime? @map("next_run_at")

  runs PipelineRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("audit_schedules")
}

model PipelineRun {
  id      String            @id @default(cuid())
  status  PipelineRunStatus @default(RUNNING)
  /// "manual" | "schedule" — how the run was triggered.
  trigger String

  /// The schedule that triggered this run, if any (SetNull — run history
  /// outlives the schedule).
  scheduleId String?        @map("schedule_id")
  schedule   AuditSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// The submission audited, if the run targeted one (SetNull — history
  /// outlives the submission).
  submissionId String?          @map("submission_id")
  submission   AuditSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  /// Per-stage results (id, status, ms, detail). OCR appears here as "skipped".
  stages Json
  error  String?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([status, startedAt])
  @@map("pipeline_runs")
}

// Immutable business-event log for one submission (Sprint 2A.2). Rows are
// append-only: never updated, never deleted independently of the submission.
model AuditTrailEntry {
  id     String           @id @default(cuid())
  action AuditTrailAction

  submissionId String          @map("submission_id")
  submission   AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id")
  actor   User   @relation("TrailActor", fields: [actorId], references: [id], onDelete: Restrict)

  /** Action-specific detail (image id, filename, old/new order, ...). IDs only — no blobs. */
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([actorId])
  @@map("audit_trail_entries")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
